# GEMINI_API_KEY: Required for Gemini AI API calls and report question answering.
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web API Key for email/password authentication (Optional: fallback local auth provided)
FIREBASE_WEB_API_KEY="your_firebase_web_api_key_here"

# Firebase Admin SDK credentials JSON path (Optional: set if using firebase-admin)
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"
